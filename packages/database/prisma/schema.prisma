// This file is the Prisma schema for the URL shortener application
// It defines all database models and their relationships

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model - stores user information
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  
  accounts      Account[]
  sessions      Session[]
  shortLinks    ShortLink[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Account model - for OAuth providers (required by NextAuth)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Session model - for session management (required by NextAuth)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// VerificationToken model - for email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ShortLink model - stores shortened URLs
model ShortLink {
  id          String    @id @default(cuid())
  slug        String    @unique
  originalUrl String    @db.Text
  
  userId      String?   // null for anonymous links
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  clickCount  Int       @default(0)
  
  clicks      Click[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([slug])
  @@index([userId])
  @@index([expiresAt])
}

// Click model - tracks analytics for each click
model Click {
  id          String    @id @default(cuid())
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  
  ipAddress   String?
  userAgent   String?   @db.Text
  referer     String?
  country     String?
  device      String?
  
  createdAt   DateTime  @default(now())
  
  @@index([shortLinkId])
  @@index([createdAt])
}

// Role enum for user authorization
enum Role {
  USER
  ADMIN
}
